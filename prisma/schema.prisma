generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum GameMode {
  BR
  LW
  CS
}

enum MatchType {
  SOLO
  DUO
  SQUAD
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  clerkId          String            @unique @db.VarChar(255)
  email            String            @unique @db.VarChar(255)
  name             String?
  image            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  profile          Profile?
  payments         Payment[]
  coins            Coins?
  transactions     CoinTransaction[]
  matchPlayers     MatchPlayer[]
  challenges       Challenge[]
  challengePlayers ChallengePlayer[]
}

model Profile {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username   String?  @unique @db.VarChar(20)
  bio        String?  @db.VarChar(100)
  avatar_img String?  @db.VarChar(255)
  banner_img String?  @db.VarChar(255)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId           String        @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  amount            Int
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Coins {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @unique @db.Uuid
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  transactions CoinTransaction[]
}

model CoinTransaction {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coinsId   String?  @db.Uuid
  coins     Coins?   @relation(fields: [coinsId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  createdAt DateTime @default(now())
}

model Game {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @db.VarChar(255)
  description String      @db.Text
  image       String      @db.VarChar(255)
  bannerImage String      @db.VarChar(255)
  modeType    GameMode    @default(BR)
  status      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  matches     Match[]
  challenges  Challenge[]

  @@unique([name, modeType])
}

model Match {
  id          String        @id @default(uuid()) @db.Uuid
  gameId      String        @db.Uuid
  game        Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  posterImg   String        @default("")
  joinStatus  Boolean       @default(false)
  joinFee     Int           @default(0)
  rules       String        @default("")
  prizePool   Int           @default(0)
  matchType   MatchType     @default(SOLO)
  maxPlayers  Int           @default(0)
  description String        @default("")
  startTime   DateTime
  endTime     DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  players     MatchPlayer[]
}

model MatchPlayer {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  matchId   String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, matchId])
}

model Admin {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Challenge {
  id             String          @id @default(uuid()) @db.Uuid
  creatorId      String          @db.Uuid
  creator        User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  gameId         String?         @db.Uuid
  game           Game?           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  customGameName String?         @db.VarChar(100)
  match_type     MatchType
  isPrivate      Boolean         @default(false)
  password       String?         @db.VarChar(50)
  entry_fee      Int             @default(0)
  prize_pool     Int             @default(0)
  room_id        String?         @db.VarChar(100)
  room_pass      String?         @db.VarChar(100)
  status         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  teams          ChallengeTeam[]
}

model ChallengeTeam {
  id          String            @id @default(uuid()) @db.Uuid
  challengeId String            @db.Uuid
  challenge   Challenge         @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  name        String
  teamNumber  Int
  players     ChallengePlayer[]
}

model ChallengePlayer {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  teamId    String        @db.Uuid
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      ChallengeTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  slot      Int
  createdAt DateTime      @default(now())

  @@unique([teamId, slot])
  @@unique([userId, teamId])
}
